      <fb:Property fb:Value="YInMM">82</fb:Property>
      <fb:Property fb:Value="WidthInMM">68</fb:Property>
      <fb:Property fb:Value="HeightInMM">34</fb:Property>
    </fb:Glyph>
    <fb:Glyph fb:ClassName="Makarov.FlowchartBuilder.Glyphs.Uml.InheritanceGlyph" id="member-is-person">
      <fb:Property fb:Value="Caption"></fb:Property>
      <fb:Property fb:Value="SourceGlyphId">member</fb:Property>
      <fb:Property fb:Value="SourcePort">0</fb:Property>
      <fb:Property fb:Value="TargetGlyphId">person</fb:Property>
      <fb:Property fb:Value="TargetPort">2</fb:Property>
    </fb:Glyph>
    <fb:Glyph fb:ClassName="Makarov.FlowchartBuilder.Glyphs.Uml.AssociationGlyph" id="loan-borrower">
      <fb:Property fb:Value="Caption">borrower</fb:Property>
      <fb:Property fb:Value="SourceGlyphId">loan</fb:Property>
      <fb:Property fb:Value="SourcePort">3</fb:Property>
      <fb:Property fb:Value="TargetGlyphId">member</fb:Property>
      <fb:Property fb:Value="TargetPort">1</fb:Property>
    </fb:Glyph>
  </fb:Sheet>
