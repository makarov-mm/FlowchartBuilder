      <fb:Property fb:Value="XInMM">54</fb:Property>
      <fb:Property fb:Value="YInMM">82</fb:Property>
      <fb:Property fb:Value="WidthInMM">84</fb:Property>
      <fb:Property fb:Value="HeightInMM">34</fb:Property>
    </fb:Glyph>
    <fb:Glyph fb:ClassName="Makarov.FlowchartBuilder.Glyphs.Uml.ClassGlyph" id="loan">
      <fb:Property fb:Value="Caption">Loan</fb:Property>
      <fb:Property fb:Value="Attributes">due_day: int</fb:Property>
      <fb:Property fb:Value="Methods">is_overdue(day: int) -&gt; bool</fb:Property>
