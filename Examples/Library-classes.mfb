<fb:FlowchartBuilderDocument Version="2.0.0.0" xmlns:fb="http://flowchartbuilder.blogspot.com">
  <fb:Sheet fb:ClassName="Makarov.FlowchartBuilder.Sheets.InfiniteSheet">
    <fb:Glyph fb:ClassName="Makarov.FlowchartBuilder.Glyphs.Uml.ClassGlyph" id="person">
      <fb:Property fb:Value="Caption">Person</fb:Property>
      <fb:Property fb:Value="Attributes">name: str</fb:Property>
