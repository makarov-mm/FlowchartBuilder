      <fb:Property fb:Value="YInMM">25</fb:Property>
      <fb:Property fb:Value="WidthInMM">84</fb:Property>
      <fb:Property fb:Value="HeightInMM">30</fb:Property>
    </fb:Glyph>
    <fb:Glyph fb:ClassName="Makarov.FlowchartBuilder.Glyphs.Uml.ClassGlyph" id="member">
      <fb:Property fb:Value="Caption">Member</fb:Property>
      <fb:Property fb:Value="Attributes">member_id: int</fb:Property>
