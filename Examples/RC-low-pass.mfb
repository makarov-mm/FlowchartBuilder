      <fb:Property fb:Value="XInMM">75</fb:Property>
      <fb:Property fb:Value="YInMM">88</fb:Property>
      <fb:Property fb:Value="Angle">0</fb:Property>
    </fb:Glyph>
    <fb:Glyph fb:ClassName="Makarov.FlowchartBuilder.Glyphs.Electrical.GroundGlyph" id="g">
      <fb:Property fb:Value="Caption"></fb:Property>
      <fb:Property fb:Value="Value"></fb:Property>
      <fb:Property fb:Value="XInMM">75</fb:Property>
      <fb:Property fb:Value="YInMM">110</fb:Property>
      <fb:Property fb:Value="Angle">0</fb:Property>
    </fb:Glyph>
    <fb:Glyph fb:ClassName="Makarov.FlowchartBuilder.Glyphs.Electrical.WireGlyph" id="e1">
      <fb:Property fb:Value="SourceGlyphId">v</fb:Property>
      <fb:Property fb:Value="SourcePort">0</fb:Property>
      <fb:Property fb:Value="TargetGlyphId">r</fb:Property>
      <fb:Property fb:Value="TargetPort">0</fb:Property>
      <fb:Property fb:Value="Caption"></fb:Property>
    </fb:Glyph>
    <fb:Glyph fb:ClassName="Makarov.FlowchartBuilder.Glyphs.Electrical.WireGlyph" id="e2">
      <fb:Property fb:Value="SourceGlyphId">r</fb:Property>
      <fb:Property fb:Value="SourcePort">1</fb:Property>
