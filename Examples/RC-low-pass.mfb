      <fb:Property fb:Value="TargetPort">0</fb:Property>
      <fb:Property fb:Value="Caption"></fb:Property>
    </fb:Glyph>
    <fb:Glyph fb:ClassName="Makarov.FlowchartBuilder.Glyphs.Electrical.WireGlyph" id="e3">
      <fb:Property fb:Value="SourceGlyphId">v</fb:Property>
      <fb:Property fb:Value="SourcePort">1</fb:Property>
      <fb:Property fb:Value="TargetGlyphId">j</fb:Property>
      <fb:Property fb:Value="TargetPort">3</fb:Property>
