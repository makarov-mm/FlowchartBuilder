<fb:FlowchartBuilderDocument Version="2.0.0.0" xmlns:fb="http://flowchartbuilder.blogspot.com">
  <fb:Sheet fb:ClassName="Makarov.FlowchartBuilder.Sheets.InfiniteSheet">
    <fb:Glyph fb:ClassName="Makarov.FlowchartBuilder.Glyphs.Electrical.AcSourceGlyph" id="v">
      <fb:Property fb:Value="Caption">V1</fb:Property>
      <fb:Property fb:Value="Value">5V 50Hz</fb:Property>
      <fb:Property fb:Value="XInMM">30</fb:Property>
      <fb:Property fb:Value="YInMM">55</fb:Property>
      <fb:Property fb:Value="Angle">90</fb:Property>
    </fb:Glyph>
    <fb:Glyph fb:ClassName="Makarov.FlowchartBuilder.Glyphs.Electrical.ResistorGlyph" id="r">
