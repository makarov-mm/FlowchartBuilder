      <fb:Property fb:Value="XInMM">75</fb:Property>
      <fb:Property fb:Value="YInMM">25</fb:Property>
      <fb:Property fb:Value="Angle">0</fb:Property>
    </fb:Glyph>
    <fb:Glyph fb:ClassName="Makarov.FlowchartBuilder.Glyphs.Electrical.CapacitorGlyph" id="c">
