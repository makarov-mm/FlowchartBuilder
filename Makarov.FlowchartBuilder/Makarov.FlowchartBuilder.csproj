<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>FlowchartBuilder.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Makarov.FlowchartBuilder.API\Makarov.FlowchartBuilder.API.csproj" />
    <ProjectReference Include="..\Makarov.Framework.Components\Makarov.Framework.Components.csproj" />
    <ProjectReference Include="..\Makarov.Framework.Core\Makarov.Framework.Core.csproj" />
    <ProjectReference Include="..\Makarov.Framework.Graphics\Makarov.Framework.Graphics.csproj" />
    <ProjectReference Include="..\Makarov.Framework.Instance\Makarov.Framework.Instance.csproj" />
    <ProjectReference Include="..\Makarov.Framework.Serialization\Makarov.Framework.Serialization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE" Link="License.txt" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="FlowchartBuilder.Tests" />
    <EmbeddedResource Include="../LICENSE" LogicalName="FlowchartBuilder.License" />
    <None Update="Data\**;Icons\**;Translations\**;*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <BundledGlyphProject Include="../Makarov.FlowchartBuilder.Glyphs.*/*.csproj" />
    <BundledGlyphSource Include="../Makarov.FlowchartBuilder.Glyphs.*/**/*.cs"
                        Exclude="../Makarov.FlowchartBuilder.Glyphs.*/obj/**;../Makarov.FlowchartBuilder.Glyphs.*/bin/**" />
    <UpToDateCheckInput Include="@(BundledGlyphProject);@(BundledGlyphSource)" />
    <UpToDateCheckOutput Include="@(BundledGlyphProject->'$(OutputPath)Plugins/%(Filename).dll')" />
  </ItemGroup>

  <!-- F5 and dotnet run can build only the startup project. Plugins reference the editor,
       so build them after its assembly exists, without recursively building their references. -->
  <Target Name="BuildBundledGlyphs" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and ('$(BuildingSolutionFile)' != 'true' or '$(BuildingInsideVisualStudio)' == 'true')"
          Inputs="$(TargetPath);@(BundledGlyphProject);@(BundledGlyphSource);$(MSBuildThisFileDirectory)../Directory.Build.props"
          Outputs="@(BundledGlyphProject->'$(TargetDir)Plugins/%(Filename).dll')">
    <MSBuild Projects="@(BundledGlyphProject)" Targets="Restore"
             Properties="Configuration=$(Configuration);RestoreRecursive=false;BuildingInsideVisualStudio=false" />
    <MSBuild Projects="@(BundledGlyphProject)" Targets="Build"
             Properties="Configuration=$(Configuration);BuildProjectReferences=false;BuildingInsideVisualStudio=false" />
  </Target>

</Project>
