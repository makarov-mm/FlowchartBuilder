<Project>

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Michael Makarov</Company>
    <Authors>Michael Makarov</Authors>
    <Product>FlowchartBuilder</Product>
    <Copyright>Copyright (c) 2008-2026 Mykhailo Makarov</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <!-- Build output layout: the application lands in <root>\Build\<Configuration>,
       glyph plugin libraries (Makarov.FlowchartBuilder.Glyphs.*) in its Plugins subfolder. -->
  <PropertyGroup>
    <!-- Directory.Build.props is read before the SDK assigns the default configuration. -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)Build\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Makarov.FlowchartBuilder.Glyphs.'))">
    <OutputPath>$(MSBuildThisFileDirectory)Build\$(Configuration)\Plugins\</OutputPath>
  </PropertyGroup>

  <!-- Keep the Plugins folder clean: plugins must not copy their references next to themselves,
       otherwise the plugin loader would load duplicate copies of the host assemblies. -->
  <ItemDefinitionGroup Condition="$(MSBuildProjectName.StartsWith('Makarov.FlowchartBuilder.Glyphs.'))">
    <ProjectReference>
      <Private>false</Private>
    </ProjectReference>
  </ItemDefinitionGroup>

</Project>
