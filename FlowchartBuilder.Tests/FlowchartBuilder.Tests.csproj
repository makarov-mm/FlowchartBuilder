<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputPath>bin/$(Configuration)/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <ProjectReference Include="../Makarov.FlowchartBuilder/Makarov.FlowchartBuilder.csproj" />
    <ProjectReference Include="../Makarov.FlowchartBuilder.Glyphs.Electrical/Makarov.FlowchartBuilder.Glyphs.Electrical.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Makarov.FlowchartBuilder.Glyphs.Simple/Makarov.FlowchartBuilder.Glyphs.Simple.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyTestPlugin" AfterTargets="Build">
    <Copy SourceFiles="../Build/$(Configuration)/Plugins/Makarov.FlowchartBuilder.Glyphs.Simple.dll;../Build/$(Configuration)/Plugins/Makarov.FlowchartBuilder.Glyphs.Electrical.dll" DestinationFolder="$(TargetDir)Plugins/" />
  </Target>
</Project>
